# Seekly Configuration
# Copy to .env and adjust as needed

# llama.cpp server URL
SEEKLY_MODEL_URL=http://127.0.0.1:8080

# Model name (used by llama.cpp)
SEEKLY_MODEL_NAME=local-model

# Database path (default: ~/.seekly/seekly.db)
# SEEKLY_DATABASE_PATH=

# Search provider: duckduckgo, tavily, serpapi
SEARCH_PROVIDER=duckduckgo

# API key for search providers (not needed for duckduckgo)
# SEARCH_API_KEY=

# Citation style: apa, mla, chicago, ieee, harvard, vancouver
SEEKLY_CITATION_STYLE=apa

# Offline mode (no web search, local only)
# SEEKLY_OFFLINE=true
