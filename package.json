{
  "name": "seekly",
  "version": "0.1.0",
  "description": "Local-first, evidence-backed CLI research agent",
  "type": "module",
  "bin": {
    "seekly": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.tsx",
    "start": "node dist/cli/index.js",
    "test": "node --test tests/**/*.test.ts",
    "lint": "tsc --noEmit",
    "seekly": "tsx src/cli/index.tsx"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "research",
    "agent",
    "cli",
    "ai",
    "llm",
    "citations"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
